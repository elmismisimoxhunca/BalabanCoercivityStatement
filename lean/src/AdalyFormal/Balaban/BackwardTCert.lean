theorem backT_hpos : ∀ t ∈ backCertSparse, 0 ≤ t.1 := by decide

theorem backT_hpos_cast : ∀ t ∈ backCertSparse.map castSparse, 0 ≤ t.1 := by
  intro t ht
  obtain ⟨s, hs, rfl⟩ := List.mem_map.mp ht
  show (0:ℝ) ≤ ((s.1 : ℤ) : ℝ)
  exact_mod_cast backT_hpos s hs

/-- **THE GRAM-FREE POSITIVITY (PROVED, no `sorry`).** For every real free-cell assignment `B`, the
genuine backward T-cert SOS value is nonnegative — proved TERM-BY-TERM via `sosQuadValue_nonneg`
(`sq_nonneg`), with NO dense `80×80` Gram formed and NO `decide` over any Gram enumeration.  Since the
per-square scale factor `W > 0`, this is `0 ≤ LocalGeomBackward0-value(B)` — the load-bearing positivity
of Bałaban Lemma 2.4 at the reference block, modulo the [RES-GEOM-REINDEX] piece-(ii) identity tying
`freecoord B` to `LocalGeomBackward0` (see the module docstring; NOT closed here). -/
theorem backTSparse_nonneg (B : Fin 80 → ℝ) :
    0 ≤ sosQuadValue (backCertSparse.map castSparse) B :=
  sosQuadValue_nonneg _ backT_hpos_cast B

